# Font
font-family = "ZedMono Nerd Font Mono"
font-size = 14

# Window Settings
confirm-close-surface = false

# Colors & Theme
theme = Everforest Dark Hard
window-vsync = true

# ==========================================
# Keybindings
# ==========================================
# If you want to disable all default keybinds like in Wezterm, uncomment this:
# keybind = clear

# Tabs and Panes (Surfaces)
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

# Clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard

# Splits
# Wezterm uses s/v for vertical/horizontal, mapping to down/right in Ghostty
keybind = ctrl+alt+s=new_split:down
keybind = ctrl+alt+v=new_split:right

# Navigate Splits
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down

# Resize Splits (Adjusted to move 10 pixels/cells per press, tweak as needed)
keybind = ctrl+shift+right=resize_split:right,10
keybind = ctrl+shift+left=resize_split:left,10
keybind = ctrl+shift+up=resize_split:up,10
keybind = ctrl+shift+down=resize_split:down,10

# Scrolling
# Ghostty does not currently support arbitrary line-count scrolling like `-10`.
# You can use standard page scrolling instead:
keybind = shift+up=scroll_page_up
keybind = shift+down=scroll_page_down

# Word Navigation (Sending Alt+b / Alt+f)
keybind = alt+left=esc:b
keybind = alt+right=esc:f
