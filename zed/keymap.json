// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: Open Default Keymap`
// from the command palette.
[
  {
    "context": "Editor && !menu",
    "bindings": {
      "ctrl-s": "workspace::Save"
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "H": "vim::FirstNonWhitespace",
      "L": "vim::EndOfLine",
      "space f f": "file_finder::Toggle",
      // "space f g": "project_search::SearchInNew",
      "space f g": "pane::DeploySearch",
      "ctrl-p": "pane::ActivateNextItem",
      "ctrl-n": "pane::ActivatePrevItem",

      "g r": "editor::FindAllReferences",

      "ctrl-shift-u": "vim::ScrollUp",
      "ctrl-u": ["workspace::SendKeystrokes", "ctrl-shift-u z z"],
      "ctrl-shift-d": "vim::ScrollDown",
      "ctrl-d": ["workspace::SendKeystrokes", "ctrl-shift-d z z"],

      // "n": ["vim::MoveToNextMatch", "zz"],
      // "N": ["vim::MoveToPrevMatch", "zz"],

      "[ e": "editor::GoToPrevDiagnostic",
      "] e": "editor::GoToDiagnostic",

      "= =": "editor::Format",
      "space a c": "editor::ToggleCodeActions",
      "ctrl-g": "outline::Toggle"
    }
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "H": "vim::FirstNonWhitespace",
      "L": "vim::EndOfLine",
      "g c": "editor::ToggleComments"
    }
  }
]
