// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `zed: Open Default Settings` command
// from the command palette
{
  "ui_font_family": "ZedMono Nerd Font Mono",
  "agent_buffer_font_size": 16.0,
  "agent_ui_font_size": 17.0,
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "edit_predictions": {
    "provider": "copilot",
  },
  "use_system_window_tabs": false,
  "tabs": {
    "show_diagnostics": "all",
    "activate_on_close": "left_neighbour",
    "file_icons": false,
    "git_status": true,
  },
  "tab_bar": {
    "show": true,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "show_completions_on_input": true,
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "base_keymap": "JetBrains",
  "buffer_font_family": "ZedMono Nerd Font Mono",
  // "buffer_font_family": ".ZedMono",
  // "buffer_font_family": "ZedMono Nerd Font Mono",
  // "buffer_font_family": "Lilex",
  "ui_font_size": 16,
  "buffer_font_size": 18.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Gruvbox Dark Hard",
  },
  "project_panel": {
    "default_width": 500,
    "dock": "right",
  },
  "vim_mode": true,
  "cursor_blink": false,
  "pane_split_direction_horizontal": "down",
  "pane_split_direction_vertical": "right",
  "use_smartcase_search": true,
  "file_finder": {
    "modal_max_width": "large",
  },
  "vim": {
    // "always": use system clipboard when no register is specified
    // "never": don't use system clipboard unless "+ or "* is specified
    // "on_yank": use system clipboard for yank operations when no register is specified
    "use_system_clipboard": "on_yank",
    // Lets `f` and `t` motions extend across multiple lines
  },
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 5,
  "sticky_scroll": {
    "enabled": true,
  },

  // disable ligatures
  "buffer_font_features": {
    "calt": false,
  },

  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_file_finder": false,
    "enable_preview_file_from_code_navigation": true,
  },

  // lsp stuff
  "languages": {
    "Ruby": {
      // "language_servers": ["!solargraph", "!sorbet", "ruby-lsp", "..."],
      "language_servers": ["ruby-lsp", "rubocop", "herb"],
    },
    "TSX": {
      "language_servers": ["!typescript-language-server", "vtsls", "..."],
      "prettier": {
        "allowed": true,
      },
    },
    "TypeScript": {
      "language_servers": ["eslint", "vtsls", "..."],
    },
  },
}
